{
  "name": "cdktf-azure-providers",
  "author": "Cyrus Wong",
  "version": "0.1.0",
  "description": "Pinned Azure-focused Terraform provider bindings generated with CDK Terrain",
  "repository": {
    "url": "https://github.com/wongcyrus/cdktf-azure-providers",
    "type": "git"
  },
  "license": "MPL-2.0",
  "keywords": [
    "cdktn",
    "cdk-terrain",
    "terraform",
    "opentofu",
    "azure"
  ],
  "scripts": {
    "get": "cdktn get",
    "build": "node --max-old-space-size=6144 \"$(node -p 'require.resolve(\"typescript/bin/tsc\")')\"",
    "synth": "cdktn synth",
    "compile": "tsc --pretty",
    "watch": "tsc -w",
    "test": "npm run build && jest --passWithNoTests",
    "test:watch": "jest --watch",
    "upgrade": "npm install cdktn@latest cdktn-cli@latest"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "peerDependencies": {
    "cdktn": "^0.24.0",
    "constructs": ">=10.6.0 <10.8.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "cdktn": "^0.24.0",
    "cdktn-cli": "^0.24.0",
    "constructs": "10.7.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
